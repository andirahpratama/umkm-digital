# Environment Variables — UMKM Digital
# Salin file ini menjadi .env dan isi nilainya

# ─── Supabase ─────────────────────────────────────────
# Ambil dari: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── JWT Secret ───────────────────────────────────────
# Buat random string panjang (minimal 32 karakter)
# Generator: https://generate-secret.vercel.app/32
JWT_SECRET=ganti-dengan-random-string-panjang-yang-aman

# ─── Port (opsional, default 3000) ────────────────────
PORT=3000
